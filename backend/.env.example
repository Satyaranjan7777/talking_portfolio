# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (Local or Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars!
JWT_EXPIRES_IN=7d
COOKIE_NAME=portfolio_admin_token

# Initial Admin Credentials (used by seed script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Changeme

# CORS Allowed Origins (Comma-separated)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Resume Settings
RESUME_MAX_MB=5
RESUME_KEEP_VERSIONS=10

# Hero Video Settings
HERO_VIDEO_MAX_MB=40
HERO_VIDEO_MAX_SECONDS=20
HERO_VIDEO_KEEP_VERSIONS=5